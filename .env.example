# Copy to .env (git-ignored) and fill in. Read by docker compose; not used by `dotnet run` (that uses user-secrets).

# GitHub OAuth app (Settings > Developer settings > OAuth Apps)
#   Homepage URL: http://localhost:3000
#   Callback URL: http://localhost:5217/signin-github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (optional; without it the login page shows GitHub only)
#   Google Cloud console > APIs & Services > Credentials > OAuth client ID, type "Web application"
#   Authorised redirect URI: http://localhost:5217/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL password. Only applied when the database volume is first created;
# `devsheet` is fine on your own machine. Change it anywhere else.
POSTGRES_PASSWORD=devsheet
